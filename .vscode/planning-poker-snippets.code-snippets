{
  // Place your planningpoker workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  //
  // You can also restrict snippets to specific files using include/exclude patterns:
  // "Test snippet": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "test",
  // 	"body": "test('$1', () => {\n\t$0\n});",
  // 	"include": ["**/*.test.ts", "*.spec.ts"],
  // 	"exclude": ["**/temp/*.ts"],
  // 	"description": "Insert test block"
  // }
  "Constructor": {
    "scope": "typescript",
    "prefix": "#constructor",
    "body": [
      "//#region Constructor & C° --------------------------------------------------",
      "public constructor() { }",
      "//#endregion"
    ],
    "description": "Insert the constructor block"
  },
  "Translation keys": {
    "scope": "typescript",
    "prefix": "#translation keys",
    "body": "//#region Translation Keys --------------------------------------------------",
    "description": "Start the translation keys region"
  },
  "Private fields": {
    "scope": "typescript",
    "prefix": "#private fields",
    "body": "//#region Private Fields ----------------------------------------------------",
    "description": "Start the private fields region"
  },
  "Protected fields": {
    "scope": "typescript",
    "prefix": "#protected fields",
    "body": "//#region Protected Fields --------------------------------------------------",
    "description": "Start the protected fields region"
  },
  "Signals": {
    "scope": "typescript",
    "prefix": "#signals",
    "body": "//#region Signals -----------------------------------------------------------",
    "description": "Start the signals region"
  },
  "Input": {
    "scope": "typescript",
    "prefix": "#input",
    "body": "//#region Component Inputs --------------------------------------------------",
    "description": "Start the inputs region"
  },
  "Getters-Setters": {
    "scope": "typescript",
    "prefix": "#getters-setters",
    "body": "//#region Getters-Setters ---------------------------------------------------",
    "description": "Start the getters-setters region"
  },
  "UI-triggers": {
    "scope": "typescript",
    "prefix": "#ui-triggers",
    "body": "//#region UI-Triggers -------------------------------------------------------",
    "description": "Start the UI-triggers region"
  },
  "Public methods": {
    "scope": "typescript",
    "prefix": "#public methods",
    "body": "//#region Public Methods ----------------------------------------------------",
    "description": "Start the Public methods region"
  },
  "Auxiliary": {
    "scope": "typescript",
    "prefix": "#auxiliary",
    "body": "//#region Auxiliary Methods -------------------------------------------------",
    "description": "Start the Auxiliary methods region"
  },
  "ESLint disable": {
    "scope": "typescript",
    "prefix": "#eslint-disable",
    "body": "/* eslint-disable $1 */",
    "description": "Insert eslint-disable"
  },
  "ESLint enable": {
    "scope": "typescript",
    "prefix": "#eslint-enable",
    "body": "/* eslint-enable $1 */",
    "description": "Insert eslint-disable"
  },
  "ESLint disable - enable": {
    "scope": "typescript",
    "prefix": "#eslint-disable-enable",
    "body": ["/* eslint-disable $1 */", "/* eslint-enable $1 */"],
    "description": "Insert eslint-disable and eslint enable"
  },
  "ESLint disable next-line": {
    "scope": "typescript",
    "prefix": "#eslint-disable",
    "body": "/* eslint-disable-next-line $1 */",
    "description": "Insert eslint-disable"
  },
  "Export": {
    "scope": "typescript",
    "prefix": "#export",
    "body": "export * from '.$1';",
    "description": "export statement"
  }
}
