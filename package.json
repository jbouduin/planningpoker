{
  "name": "planningpoker",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "prebuild": "node prebuild.js",
    "build:site": "npm run prebuild && ng build --configuration production",
    "build:shared": "cd projects/shared-lib && npm run build",
    "start:site": "ng serve",
    "start:server": "cd projects/server && npm run dev",
    "lint:site": "ng lint && stylelint \"src/**/*.scss\" && htmlhint \"src\" --config .htmlhintrc",
    "lint:server": "cd projects/server && npm run lint",
    "lint:shared": "cd projects/shared-lib && eslint -c .eslintrc --ext .js,.jsx,.ts,.tsx",
    "test:site": "ng test",
    "test:site-coverage": "ng test  --code-coverage --no-watch",
    "test:translations": "npm run translations && node test-translations",
    "test:server:ci": "cd projects/server && npm run test:ci",
    "e2e": "ng e2e",
    "generate": "ng generate",
    "translations": "npm run translations:extract:us && npm run translations:extract:de",
    "translations:extract:template": "ngx-translate-extract -i './src' --output './src/translations/template.json' -f=json --clean -s --marker extract",
    "translations:extract:us": "ngx-translate-extract -i './src' --output './src/translations/en-US.json' -f=json --clean -s --marker extract",
    "translations:extract:de": "ngx-translate-extract -i './src' --output './src/translations/de-DE.json' -f=json --clean -s --marker extract",
    "reset": "curl -X POST localhost:3001/82b52f20-24e6-44c0-a87d-701c150858a0/reset"
  },
  "dependencies": {
    "@angular/animations": "^15.0.4",
    "@angular/cdk": "^15.0.3",
    "@angular/common": "^15.0.4",
    "@angular/compiler": "^15.0.4",
    "@angular/core": "^15.0.4",
    "@angular/forms": "^15.0.4",
    "@angular/material": "^15.0.3",
    "@angular/platform-browser": "^15.0.4",
    "@angular/platform-browser-dynamic": "^15.0.4",
    "@angular/router": "^15.0.4",
    "@angular/service-worker": "^15.0.4",
    "@jbouduin/ngx-translate-extract-marker": "^0.0.1",
    "@ngx-translate/core": "^14.0.0",
    "marked": "^4.2.12",
    "material-design-icons-iconfont": "^6.1.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.4.1",
    "zone": "^0.3.4",
    "zone.js": "^0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.0.4",
    "@angular-eslint/builder": "15.1.0",
    "@angular-eslint/eslint-plugin": "15.1.0",
    "@angular-eslint/eslint-plugin-template": "15.1.0",
    "@angular-eslint/schematics": "15.1.0",
    "@angular-eslint/template-parser": "15.1.0",
    "@angular/cli": "^15.0.4",
    "@angular/compiler-cli": "^15.0.4",
    "@angular/language-service": "^15.0.4",
    "@angularclass/hmr": "^3.0.0",
    "@jbouduin/ngx-translate-extract": "^8.0.4",
    "@types/jasmine": "^4.3.1",
    "@types/marked": "^4.0.8",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "colorette": "^2.0.19",
    "create-wdio": "^8.2.2",
    "eslint": "^8.28.0",
    "eslint-plugin-ban": "^1.6.0",
    "eslint-plugin-deprecation": "^1.3.3",
    "eslint-plugin-tsdoc": "^0.2.17",
    "htmlhint": "^1.1.4",
    "jasmine-core": "^4.5.0",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.1.1",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "stylelint": "^15.3.0",
    "stylelint-config-recommended-scss": "^9.0.1",
    "stylelint-config-standard": "^31.0.0",
    "stylelint-scss": "^4.3.0",
    "ts-node": "^10.9.1",
    "typescript": ">=4.8.2 < 4.9.0"
  }
}
