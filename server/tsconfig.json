{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "pretty": true,
    "sourceMap": true,
    "target": "ES2020",
    "rootDir": ".",
    "outDir": "./dist/prod",
    "strict": true,
    "lib": ["ES2020"],
    "types": ["reflect-metadata", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowJs": false,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
    // "test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
