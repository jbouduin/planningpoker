{
  "name": "planningpoker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "npm run env -s && ng build --configuration production",
    "start": "npm run env -s && ng serve --proxy-config proxy.conf.js",
    "deploy": "npm run env -s && ng deploy",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "ng lint && stylelint \"src/**/*.scss\" --syntax scss && htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run env -s && ng test",
    "test:ci": "npm run env -s && npm run lint -s && ng test --configuration=ci",
    "e2e": "npm run env -s && ng e2e",
    "translations:extract": "ngx-translate-extract -i './src' --output './src/translations/template.json' -f=json --clean -s --marker extract",
    "translations:extract:us": "ngx-translate-extract -i './src' --output './src/translations/en-US.json' -f=json --clean -s --marker extract",
    "translations:extract:de": "ngx-translate-extract -i './src' --output './src/translations/de-DE.json' -f=json --clean -s --marker extract",
    "env": "ngx-scripts env npm_package_version",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular/animations": "^15.0.4",
    "@angular/cdk": "^15.0.3",
    "@angular/common": "^15.0.4",
    "@angular/compiler": "^15.0.4",
    "@angular/core": "^15.0.4",
    "@angular/forms": "^15.0.4",
    "@angular/material": "^15.0.3",
    "@angular/platform-browser": "^15.0.4",
    "@angular/platform-browser-dynamic": "^15.0.4",
    "@angular/router": "^15.0.4",
    "@angular/service-worker": "^15.0.4",
    "@ngx-translate/core": "^13.0.0",
    "@types/socket.io-client": "^1.4.36",
    "material-design-icons-iconfont": "^6.1.1",
    "rxjs": "^7.4.0",
    "tslib": "^2.3.1",
    "typescript-collections": "^1.3.3",
    "zone": "^0.3.4",
    "zone.js": "^0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.0.4",
    "@angular/cli": "^15.0.4",
    "@angular/compiler-cli": "^15.0.4",
    "@angular/language-service": "^15.0.4",
    "@angularclass/hmr": "^3.0.0",
    "@biesbjerg/ngx-translate-extract": "^7.0.4",
    "@netlify-builder/deploy": "^4.1.2",
    "@ngx-rocket/scripts": "^5.1.1",
    "@types/jasmine": "^3.10.1",
    "@types/jasminewd2": "^2.0.10",
    "@types/node": "^16.11.6",
    "codelyzer": "^6.0.2",
    "htmlhint": "^0.16.0",
    "https-proxy-agent": "^5.0.0",
    "jasmine-core": "~3.10.1",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.3.7",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^4.0.1",
    "karma-jasmine-html-reporter": "^1.7.0",
    "karma-junit-reporter": "^2.0.1",
    "protractor": "^7.0.0",
    "stylelint": "~14.0.1",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recommended-scss": "~5.0.1",
    "stylelint-config-standard": "~23.0.0",
    "stylelint-scss": "~4.0.0",
    "ts-node": "^10.4.0",
    "tslint": "~5.20.1",
    "typescript": ">=4.8.2 < 4.9.0"
  }
}
