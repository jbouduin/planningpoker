{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "pretty": true,
    "sourceMap": true,
    "target": "es6",
    "outDir": "../../dist/server",
    "strict": true,
    "baseUrl": "./src",
    "lib": [ "es6", "dom" ],
    "types": [ "reflect-metadata", "node", "jest" ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowJs": true
  },
  "references": [
    { "path": "../shared-lib" }
  ],
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
