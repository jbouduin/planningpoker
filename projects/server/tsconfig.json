{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "pretty": true,
    "sourceMap": true,
    "target": "es6",
    "outDir": "../../dist/server",
    "strict": true,
    "baseUrl": "./src",
    "lib": [ "es6", "dom" ],
    "types": [ "reflect-metadata", "node" ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "references": [
    { "path": "../shared-lib" }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
